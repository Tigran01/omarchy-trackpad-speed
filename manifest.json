{
  "schemaVersion": 1,
  "id": "io.github.tigran01.trackpad-speed",
  "name": "Trackpad Speed",
  "version": "1.1.1",
  "author": "Tigran01",
  "license": "MIT",
  "description": "A fast, theme-aware trackpad speed control for Omarchy",
  "kinds": [
    "service",
    "panel",
    "bar-widget"
  ],
  "keepLoaded": false,
  "entryPoints": {
    "service": "Service.qml",
    "panel": "Settings.qml",
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Trackpad Speed",
    "description": "Adjust trackpad pointer speed from the Omarchy bar",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "right"
  }
}
